# ─────────────────────────────────────────────────────────────────────────────
# .env.example — safe to commit, contains no real secrets
# Copy this to .env.local for local development and fill in real values.
# See CLAUDE.md → "Environment Strategy" for full setup instructions.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase / Neon) ────────────────────────────────────────────────
# Transaction pooler URL (port 6543, PgBouncer) — used by the app
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"
# Direct session URL (port 5432) — used by Prisma for migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ── App URLs ──────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# ── Google Calendar Sync ──────────────────────────────────────────────────────
GCAL_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"
# Generate: openssl rand -hex 32
GCAL_ENCRYPTION_KEY=""

# ── Cron jobs ────────────────────────────────────────────────────────────────
# Protects /api/cron/* endpoints. Generate: openssl rand -hex 24
CRON_SECRET=""

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Get at: https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="Petra <onboarding@resend.dev>"

# ── Invoicing (Morning / חשבשבת) ─────────────────────────────────────────────
# Generate: openssl rand -hex 32
INVOICING_ENCRYPTION_KEY=""

# ── Stripe ────────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
STRIPE_ENCRYPTION_KEY=""

# ── Make.com Webhook ─────────────────────────────────────────────────────────
# Generate: openssl rand -hex 24
MAKE_WEBHOOK_SECRET=""
# Business ID that receives leads from Make.com webhook
WEBHOOK_BUSINESS_ID=""

# ── Vercel Blob (file uploads) ────────────────────────────────────────────────
# Get from: Vercel Dashboard → Storage → Blob → your store → .env.local button
BLOB_READ_WRITE_TOKEN=""

# ── Twilio / WhatsApp ─────────────────────────────────────────────────────────
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Twilio sandbox number or approved business number
TWILIO_WHATSAPP_FROM="+14155238886"

# ── WhatsApp — Meta Cloud API (platform number) ───────────────────────────────
# Permanent system-user token + the platform phone number every business sends from
# until it connects its own number.
META_WHATSAPP_TOKEN=""
META_PHONE_NUMBER_ID=""
# Platform WhatsApp Business Account id (templates are copied FROM here). Default: 25882288788086856
META_WABA_ID="25882288788086856"
# Verify token for GET /api/webhooks/whatsapp-status (Meta dashboard → Webhooks)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# ── WhatsApp — per-business numbers (Meta Embedded Signup) ────────────────────
# Meta App id (public — used by the FB JS SDK in the browser) and the Embedded Signup
# configuration id (Meta dashboard → WhatsApp → Embedded Signup → Configurations).
NEXT_PUBLIC_META_APP_ID=""
NEXT_PUBLIC_META_ES_CONFIG_ID=""
# Optional server-side copy of the app id (defaults to NEXT_PUBLIC_META_APP_ID)
META_APP_ID=""
# App secret — exchanges the signup code for a business token AND verifies
# X-Hub-Signature-256 on the statuses webhook (when unset the webhook accepts unsigned posts)
META_APP_SECRET=""
# Optional: key for encrypting business WhatsApp tokens (64-hex, openssl rand -hex 32).
# Falls back to GCAL_ENCRYPTION_KEY when unset.
WHATSAPP_ENCRYPTION_KEY=""
# Optional: 6-digit two-step PIN used when registering a business number for Cloud API (default 000000)
WHATSAPP_REGISTER_PIN=""
